# Copy to .env and fill in. Never commit .env.
TINYFISH_API_KEY=
# Comma-separated list of frontend origins allowed by CORS.
# Defaults to http://localhost:5173,http://localhost:3000 when empty.
ALLOWED_ORIGINS=
# Optional: Public HTTPS base URL (e.g. https://xxxx.lhr.life or ngrok URL) pointing to this backend.
# When set, preset runs without a start_url automatically map to ${PUBLIC_DEMO_BASE_URL}/demo-site/... for live TinyFish runs.
PUBLIC_DEMO_BASE_URL=
# Optional: TinyFish browser profile ("stealth" or "lite"). Defaults to "stealth" for external sites and "lite" for tunnels.
TINYFISH_BROWSER_PROFILE=
# Optional: ISO 3166-1 alpha-2 country code for TinyFish proxy on external sites (e.g. IN).
TINYFISH_PROXY_COUNTRY=
# Optional: Saved TinyFish Browser Context Profile ID & Credential Vault for dedicated test accounts.
# Keeps test-account auth inside TinyFish's runner store so passwords never enter ExitLens API payloads.
TINYFISH_PROFILE_ID=
TINYFISH_USE_VAULT=
TINYFISH_CREDENTIAL_ITEM_IDS=
# Optional: Max seconds a live TinyFish run may take before it is stopped and reported as failed. Defaults to 300.
TINYFISH_RUN_TIMEOUT_SECONDS=
